# BenchSim GTKWave profile

# Dark canvas and high-contrast waveform states.
color_back 111111
color_0 00a84f
color_1 39ff14
color_high 39ff14
color_low 00a84f

# Supporting UI colors for the time ruler, vector values, and grid.
color_grid 2f2f2f
color_time e6e6e6
color_value e6e6e6

# Increase waveform legibility without changing the trace semantics.
use_fat_lines 1
show_grid 1
use_roundcaps 1

# Keep signal labels readable while preserving compact wave rows.
fontname_signals Monospace 13
fontname_waves Monospace 12

# Fit the complete simulation time range when GTKWave opens.
do_initial_zoom_fit yes
